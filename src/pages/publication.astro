---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

const publicationPost = await getEntry("spec", "publication");
if (!publicationPost) {
    throw new Error("Publication page content not found");
}
const { Content } = await render(publicationPost);
---
<MainGridLayout title={i18n(I18nKey.publication)} description={i18n(I18nKey.publication)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <h1 class="text-4xl font-bold">{i18n(I18nKey.publication)}</h1>
            <p class="mt-4 text-base leading-8 text-[var(--text-muted)]">
                This page lists my latest publications, research articles, and selected academic work.
            </p>
        </div>
    </div>

    <div class="mt-6">
        <Markdown class="mt-6">
            <Content />
        </Markdown>
    </div>
</MainGridLayout>
