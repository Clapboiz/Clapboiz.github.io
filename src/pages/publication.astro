---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

const publicationPost = await getEntry("spec", "publication-list");
if (!publicationPost) {
    throw new Error("Publication page content not found");
}
const { Content } = await render(publicationPost);
const entries = publicationPost.data.entries ?? [];

const groups: { year: number; entries: typeof entries }[] = (() => {
    const grouped: { [year: number]: typeof entries } = {};
    entries.forEach((entry) => {
        const year = new Date(entry.date).getFullYear();
        if (!grouped[year]) grouped[year] = [];
        grouped[year].push(entry);
    });
    return Object.keys(grouped)
        .map((year) => ({
            year: Number(year),
            entries: grouped[Number(year)].sort(
                (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
            ),
        }))
        .sort((a, b) => b.year - a.year);
})();

function formatDate(date: string) {
    const parsed = new Date(date);
    if (Number.isNaN(parsed.getTime())) return date;
    const month = String(parsed.getMonth() + 1).padStart(2, "0");
    const day = String(parsed.getDate()).padStart(2, "0");
    return `${month}-${day}`;
}

function doiLabel(doi: string) {
    return doi.startsWith("https://doi.org/") ? doi.replace("https://doi.org/", "") : doi;
}
---
<MainGridLayout title={i18n(I18nKey.publication)} description={publicationPost.data.description ?? i18n(I18nKey.publication)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>

    <div class="mt-6">
        <div class="card-base px-8 py-6">
            {groups.map((group) => (
                <div>
                    <div class="flex flex-row w-full items-center h-[3.75rem]">
                        <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">{group.year}</div>
                        <div class="w-[15%] md:w-[10%]">
                            <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                        </div>
                        <div class="w-[70%] md:w-[80%] transition text-left text-50">{group.entries.length} publications</div>
                    </div>
                    {group.entries.map((entry) => (
                        <div class="group btn-plain !block w-full rounded-lg border border-[var(--border)] bg-[var(--card-bg)] p-5 mb-4 hover:border-[var(--primary)] transition-all">
                            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                                <div class="space-y-2">
                                    <div class="inline-flex items-center rounded-full bg-[var(--primary)/10] px-3 py-1 text-sm font-semibold text-[var(--primary)]">
                                        {entry.feature}
                                    </div>
                                    <div class="text-xl font-bold text-75">{entry.title}</div>
                                    <div class="flex flex-wrap gap-3 text-sm text-[var(--text-muted)]">
                                        <span>{entry.journal}</span>
                                        <span>· {formatDate(entry.date)}</span>
                                        <a href={entry.doi} target="_blank" rel="noopener noreferrer" class="text-[var(--primary)] hover:underline">
                                            DOI: {doiLabel(entry.doi)}
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <details class="mt-4 rounded-[var(--radius-medium)] border border-[var(--border)] bg-[var(--card-bg)] p-4">
                                <summary class="cursor-pointer text-[var(--primary)] font-semibold">Abstract</summary>
                                <p class="mt-3 text-sm leading-7 text-[var(--text-muted)] whitespace-pre-line">{entry.abstract}</p>
                            </details>
                        </div>
                    ))}
                </div>
            ))}
        </div>
    </div>
</MainGridLayout>
